ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the default model used for all pipeline LLM calls
INFLUENCERLAW_MODEL=claude-sonnet-5

# Music licensing (Module E) - get a free-tier key at https://dashboard.audd.io/
# (300 free recognition requests to start, then $5/1000). Without this set, the
# Music Licensing module is disabled and the dashboard says so explicitly.
AUDD_API_KEY=
