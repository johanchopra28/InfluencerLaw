# Free API key, no card required - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional backup analysis service. If set, a request that fails on the first-choice
# service is retried once on the other. Get a free key at https://console.groq.com/keys
# Never commit real keys. Contracts may be sent to whichever service runs the request.
GROQ_API_KEY=
# HYPECHECK_PROVIDER=gemini            # or "groq" to try Groq first
# HYPECHECK_GROQ_MODEL=openai/gpt-oss-120b
# HYPECHECK_GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: override the default model used for all pipeline LLM calls
# (default is gemini-flash-lite-latest -- the flash tier has been returning
# persistent 503s, see app/config.py)
HYPECHECK_MODEL=gemini-flash-lite-latest

# Music licensing (Module E) - get a free-tier key at https://dashboard.audd.io/
# (300 free recognition requests to start, then $5/1000). Without this set, the
# Music Licensing module is disabled and the dashboard says so explicitly.
AUDD_API_KEY=
